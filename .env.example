NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated Gmail addresses that should become admin after first login + SQL promote
ADMIN_EMAILS=you@gmail.com

# Gemini API (server-only, never prefix with NEXT_PUBLIC_). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional, defaults to gemini-3.5-flash
GEMINI_MODEL=

# Google Maps JavaScript API key (browser key, restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
